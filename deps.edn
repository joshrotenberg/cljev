{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.babashka/http-client {:mvn/version "0.4.22"}
        cheshire/cheshire {:mvn/version "5.13.0"}}
 :aliases {;; clojure -T:build jar | deploy (build.clj)
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}
           ;; a REPL with the examples: clojure -A:dev
           :dev {:extra-paths ["examples"]}
           ;; http-kit: the local server the HTTP tests talk to; Babashka bundles it
           :test {:extra-paths ["test" "examples"]
                  :extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}}
                  :main-opts ["-m" "cljev.test-runner"]}
           ;; opt-in tests that call the TypeSafe API (test-live/)
           :live {:extra-paths ["test-live"]
                  :main-opts ["-m" "cljev.live-test-runner"]}
           ;; clojure -M:cljfmt check | fix
           :cljfmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.13.0"}}
                    :main-opts ["-m" "cljfmt.main"]}}}
